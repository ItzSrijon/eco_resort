<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer.section1.group7.eco_resort.Nazmun.Controller.ChefRecordFoodWasteController">

    <Label layoutX="320.0" layoutY="20.0" text="Food Waste Log">
        <font>
            <Font name="System Bold" size="20.0" />
        </font>
    </Label>

    <!-- Log Waste Entry Section -->
    <Label layoutX="30.0" layoutY="60.0" text="Log Wasted Ingredient">
        <font>
            <Font name="System Bold" size="14.0" />
        </font>
    </Label>

    <VBox layoutX="30.0" layoutY="90.0" prefWidth="840.0" spacing="10.0">
        <padding>
            <Insets bottom="10.0" left="0.0" right="0.0" top="0.0" />
        </padding>

        <HBox spacing="10.0">
            <ComboBox fx:id="itemCB" prefWidth="220.0" promptText="Ingredient" />
            <TextField fx:id="quantityTF" prefWidth="150.0" promptText="Quantity Wasted" />
            <ComboBox fx:id="reasonCB" prefWidth="200.0" promptText="Reason" />
            <Button fx:id="logWasteButtonOA" onAction="#logWasteButtonOA" text="Log Waste" />
        </HBox>

        <Label fx:id="wasteMessageLabel" textFill="RED" />
    </VBox>

    <!-- Waste Log TableView -->
    <Label layoutX="30.0" layoutY="162.0" text="Today's Waste Log">
        <font>
            <Font name="System Bold" size="14.0" />
        </font>
    </Label>

    <TableView fx:id="wasteTableView" layoutX="20.0" layoutY="188.0" prefHeight="169.0" prefWidth="850.0">
        <columns>
            <TableColumn fx:id="wasteItemNameTC" prefWidth="260.0" text="Ingredient" />
            <TableColumn fx:id="wasteQuantityTC" prefWidth="220.0" text="Quantity Wasted" />
            <TableColumn fx:id="wasteReasonTC" prefWidth="260.0" text="Reason" />
        </columns>
    </TableView>

    <!-- Updated Inventory TableView -->
    <Label layoutX="26.0" layoutY="371.0" text="Updated Inventory">
        <font>
            <Font name="System Bold" size="14.0" />
        </font>
    </Label>

    <TableView fx:id="inventoryTableView" layoutX="30.0" layoutY="404.0" prefHeight="170.0" prefWidth="840.0">
        <columns>
            <TableColumn fx:id="invQuantityTC" prefWidth="280.0" text="Current Quantity" />
            <TableColumn fx:id="invItemNameTC" prefWidth="280.0" text="Ingredient" />
        </columns>
    </TableView>

    <Button fx:id="backButtonOA" layoutX="30.0" layoutY="584.0" onAction="#backButtonOA" text="Back to Dashboard" />

</AnchorPane>
