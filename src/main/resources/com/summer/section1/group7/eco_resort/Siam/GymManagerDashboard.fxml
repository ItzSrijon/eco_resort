<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="mainPane"
            prefHeight="620.0"
            prefWidth="750.0"
            style="-fx-background-color:#ECEFF1;"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.summer.section1.group7.eco_resort.Siam.GymManagerDashboardController">

   <children>

      <Label alignment="CENTER"
             prefHeight="65"
             prefWidth="750"
             style="-fx-background-color:#263238;
                      -fx-text-fill:white;"
             text="Gym Manager Dashboard">

         <font>
            <Font name="System Bold" size="26"/>
         </font>

      </Label>

      <VBox layoutX="30"
            layoutY="95"
            prefWidth="690"
            prefHeight="490"
            spacing="28"
            style="-fx-background-color:white;
                     -fx-background-radius:18;
                     -fx-border-radius:18;
                     -fx-border-color:#CFD8DC;">

         <padding>
            <Insets top="30"
                    right="30"
                    bottom="30"
                    left="30"/>
         </padding>

         <children>

            <GridPane hgap="30"
                      vgap="22">

               <columnConstraints>
                  <ColumnConstraints prefWidth="300"/>
                  <ColumnConstraints prefWidth="300"/>
               </columnConstraints>

               <rowConstraints>
                  <RowConstraints/>
                  <RowConstraints/>
                  <RowConstraints/>
                  <RowConstraints/>
               </rowConstraints>

               <children>

                  <Button
                          text="👤 Register New Gym Member"
                          prefWidth="280"
                          prefHeight="56"
                          onAction="#registerNewGymMemberOA"
                          style="-fx-background-color:#1565C0;
                                       -fx-text-fill:white;
                                       -fx-background-radius:12;
                                       -fx-cursor:hand;">

                     <font>
                        <Font name="System Bold" size="13"/>
                     </font>

                  </Button>

                  <Button
                          text="🔄 Update Membership Status"
                          GridPane.columnIndex="1"
                          prefWidth="280"
                          prefHeight="56"
                          onAction="#updateMembershipStatusOA"
                          style="-fx-background-color:#1565C0;
                                       -fx-text-fill:white;
                                       -fx-background-radius:12;
                                       -fx-cursor:hand;">

                     <font>
                        <Font name="System Bold" size="13"/>
                     </font>

                  </Button>

                  <Button
                          text="📅 Schedule Training Session"
                          GridPane.rowIndex="1"
                          prefWidth="280"
                          prefHeight="56"
                          onAction="#scheduleTrainingSessionOA"
                          style="-fx-background-color:#1565C0;
                                       -fx-text-fill:white;
                                       -fx-background-radius:12;
                                       -fx-cursor:hand;">

                     <font>
                        <Font name="System Bold" size="13"/>
                     </font>

                  </Button>

                  <Button
                          text="✅ Record Gym Attendance"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="1"
                          prefWidth="280"
                          prefHeight="56"
                          onAction="#recordGYmAttendanceOA"
                          style="-fx-background-color:#1565C0;
                                       -fx-text-fill:white;
                                       -fx-background-radius:12;
                                       -fx-cursor:hand;">

                     <font>
                        <Font name="System Bold" size="13"/>
                     </font>

                  </Button>
                  <Button
                          text="🏋 Manage Equipment Usage"
                          GridPane.rowIndex="2"
                          prefWidth="280"
                          prefHeight="56"
                          onAction="#manageEquipmentUsageOA"
                          style="-fx-background-color:#1565C0;
                                       -fx-text-fill:white;
                                       -fx-background-radius:12;
                                       -fx-cursor:hand;">

                     <font>
                        <Font name="System Bold" size="13"/>
                     </font>

                  </Button>

                  <Button
                          text="📋 View Gym Members"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="2"
                          prefWidth="280"
                          prefHeight="56"
                          onAction="#viewGymMembersOA"
                          style="-fx-background-color:#1565C0;
                                       -fx-text-fill:white;
                                       -fx-background-radius:12;
                                       -fx-cursor:hand;">

                     <font>
                        <Font name="System Bold" size="13"/>
                     </font>

                  </Button>

                  <Button
                          text="💪 Assign Fitness Package"
                          GridPane.rowIndex="3"
                          prefWidth="280"
                          prefHeight="56"
                          onAction="#assignFitnessPackageOA"
                          style="-fx-background-color:#1565C0;
                                       -fx-text-fill:white;
                                       -fx-background-radius:12;
                                       -fx-cursor:hand;">

                     <font>
                        <Font name="System Bold" size="13"/>
                     </font>

                  </Button>

                  <Button
                          text="📊 Gym Activity Summary"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="3"
                          prefWidth="280"
                          prefHeight="56"
                          onAction="#gymActivitySummaryOA"
                          style="-fx-background-color:#1565C0;
                                       -fx-text-fill:white;
                                       -fx-background-radius:12;
                                       -fx-cursor:hand;">

                     <font>
                        <Font name="System Bold" size="13"/>
                     </font>

                  </Button>

               </children>

            </GridPane>

            <Separator/>

            <HBox alignment="CENTER">

               <Button
                       text="← Back to Login"
                       prefWidth="220"
                       prefHeight="48"
                       onAction="#backToLoginPageOA"
                       style="-fx-background-color:#C62828;
                                   -fx-text-fill:white;
                                   -fx-background-radius:12;
                                   -fx-cursor:hand;">

                  <font>
                     <Font name="System Bold" size="13"/>
                  </font>

               </Button>

            </HBox>

         </children>

      </VBox>

   </children>

</AnchorPane>