<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="mainPane"
            prefHeight="620.0"
            prefWidth="750.0"
            style="-fx-background-color:#ECEFF1;"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.summer.section1.group7.eco_resort.Siam.U3G8_GymActivitySummaryController">

    <children>

        <!-- Header -->

        <Label alignment="CENTER"
               prefHeight="60"
               prefWidth="750"
               text="Gym Activity Summary Report"
               style="-fx-background-color:#263238;
                      -fx-text-fill:white;">

            <font>
                <Font name="System Bold" size="22"/>
            </font>

        </Label>

        <!-- Main Card -->

        <VBox layoutX="30"
              layoutY="80"
              prefWidth="690"
              prefHeight="510"
              spacing="18"
              style="-fx-background-color:white;
                     -fx-background-radius:15;
                     -fx-border-radius:15;
                     -fx-border-color:#CFD8DC;">

            <padding>
                <Insets top="20"
                        right="20"
                        bottom="20"
                        left="20"/>
            </padding>

            <children>

                <!-- Date Filter -->

                <GridPane hgap="15"
                          vgap="10">

                    <columnConstraints>
                        <ColumnConstraints prefWidth="100"/>
                        <ColumnConstraints prefWidth="180"/>
                        <ColumnConstraints prefWidth="80"/>
                        <ColumnConstraints prefWidth="180"/>
                        <ColumnConstraints prefWidth="120"/>
                    </columnConstraints>

                    <Label text="From Date:"
                           GridPane.columnIndex="0"/>

                    <DatePicker fx:id="fromDateDP"
                                prefWidth="170"
                                GridPane.columnIndex="1"/>

                    <Label text="To Date:"
                           GridPane.columnIndex="2"/>

                    <DatePicker fx:id="toDateDP"
                                prefWidth="170"
                                GridPane.columnIndex="3"/>

                    <Button text="Generate"
                            prefWidth="110"
                            onAction="#generateSummaryOA"
                            style="-fx-background-color:#2E7D32;
                                   -fx-text-fill:white;
                                   -fx-background-radius:10;"
                            GridPane.columnIndex="4">

                        <font>
                            <Font name="System Bold" size="12"/>
                        </font>

                    </Button>

                </GridPane>

                <Separator/>

                <!-- Summary Table -->

                <TableView fx:id="summaryTV"
                           prefHeight="330">

                    <columns>

                        <TableColumn fx:id="summaryItemTC"
                                     text="Summary Item"
                                     prefWidth="430"/>

                        <TableColumn fx:id="valueTC"
                                     text="Value"
                                     prefWidth="220"/>

                    </columns>

                </TableView>

                <Separator/>

                <!-- Buttons -->

                <HBox alignment="CENTER"
                      spacing="20">

                    <Button text="Export PDF"
                            prefWidth="180"
                            prefHeight="45"
                            onAction="#exportPdfOA"
                            style="-fx-background-color:#D32F2F;
                   -fx-text-fill:white;
                   -fx-background-radius:10;">

                        <font>
                            <Font name="System Bold" size="13"/>
                        </font>

                    </Button>

                    <Button text="Back to Dashboard"
                            prefWidth="180"
                            prefHeight="45"
                            onAction="#backToDashboardOA"
                            style="-fx-background-color:#616161;
                   -fx-text-fill:white;
                   -fx-background-radius:10;">

                        <font>
                            <Font name="System Bold" size="13"/>
                        </font>

                    </Button>

                </HBox>

            </children>

        </VBox>

    </children>

</AnchorPane>