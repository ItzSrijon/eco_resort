<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer.section1.group7.eco_resort.Piya.controller.SecurityOfficerCheckIn">
   <children>
      <Label layoutX="233.0" layoutY="14.0" text="Check-In Records">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Label>
      <TableView fx:id="checkInTV" layoutX="53.0" layoutY="78.0" prefHeight="200.0" prefWidth="510.0">
        <columns>
          <TableColumn fx:id="reservationIdTC" prefWidth="91.0" text="Reservation ID" />
          <TableColumn fx:id="guestNameTC" prefWidth="98.5" text="Guest Name" />
            <TableColumn fx:id="roomNumberTC" prefWidth="117.5" text="Room Number" />
            <TableColumn fx:id="bookingDateTC" prefWidth="100.5" text="Booking Date" />
            <TableColumn fx:id="bookingStatusTC" prefWidth="101.5" text="Booking Status" />
        </columns>
      </TableView>
      <Button layoutX="326.0" layoutY="295.0" mnemonicParsing="false" onAction="#refreshButtonOA" prefHeight="36.0" prefWidth="103.0" text="Refresh" />
      <Label layoutX="118.0" layoutY="46.0" text="Guest Check-In List !!!" />
      <Label fx:id="mssageLabel" layoutX="193.0" layoutY="343.0" prefHeight="36.0" prefWidth="174.0" />
      <Button layoutX="23.0" layoutY="335.0" mnemonicParsing="false" onAction="#backButtonOA" prefHeight="51.0" prefWidth="83.0" text="Back" />
      <TextField fx:id="arrivalTimeTF" layoutX="118.0" layoutY="295.0" />
      <Label layoutX="37.0" layoutY="299.0" text="Arrival Time :" />
      <Button layoutX="458.0" layoutY="295.0" mnemonicParsing="false" onAction="#saveButtonOA" prefHeight="36.0" prefWidth="103.0" text="Save" />
   </children>
</AnchorPane>
