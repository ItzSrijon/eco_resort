<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="mainPane" prefHeight="550.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer.section1.group7.eco_resort.Siam.U4G1_RecordGuestPaymentController">

    <children>

        <Label alignment="CENTER" layoutX="0.0" layoutY="0.0" prefHeight="60.0" prefWidth="700.0" style="-fx-background-color: grey;" text="Record Guest Payment">

            <font>
                <Font name="System Bold" size="22.0" />
            </font>

        </Label>

        <Label layoutX="40.0" layoutY="90.0" text="Guest ID:">
            <font>
                <Font name="System Bold" size="13.0" />
            </font>
        </Label>

        <TextField fx:id="guestIdTF" layoutX="170.0" layoutY="85.0" prefWidth="180.0" />

        <Button layoutX="380.0" layoutY="84.0" onAction="#searchGuestOA" prefWidth="120.0" text="Search Guest">
            <font>
                <Font name="System Bold" size="12.0" />
            </font>
        </Button>

        <Label layoutX="40.0" layoutY="150.0" text="Guest Name:">
            <font>
                <Font name="System Bold" size="13.0" />
            </font>
        </Label>

        <TextField fx:id="guestNameTF" editable="false" layoutX="170.0" layoutY="145.0" prefWidth="250.0" />

        <Label layoutX="40.0" layoutY="205.0" text="Invoice ID:">
            <font>
                <Font name="System Bold" size="13.0" />
            </font>
        </Label>

        <TextField fx:id="invoiceIdTF" editable="false" layoutX="170.0" layoutY="200.0" prefWidth="180.0" />

        <Label layoutX="40.0" layoutY="260.0" text="Total Amount:">
            <font>
                <Font name="System Bold" size="13.0" />
            </font>
        </Label>

        <TextField fx:id="totalAmountTF" editable="false" layoutX="170.0" layoutY="255.0" prefWidth="180.0" />

        <Label layoutX="40.0" layoutY="315.0" text="Payment Method:">
            <font>
                <Font name="System Bold" size="13.0" />
            </font>
        </Label>

        <ComboBox fx:id="paymentMethodCB" layoutX="170.0" layoutY="310.0" prefWidth="180.0" />

        <Label layoutX="40.0" layoutY="370.0" text="Payment Date:">
            <font>
                <Font name="System Bold" size="13.0" />
            </font>
        </Label>

        <TextField fx:id="paymentDateTF" editable="false" layoutX="170.0" layoutY="365.0" prefWidth="180.0" />

        <Button layoutX="150.0" layoutY="460.0" onAction="#recordPaymentOA" prefHeight="40.0" prefWidth="170.0" text="Record Payment">
            <font>
                <Font name="System Bold" size="13.0" />
            </font>
        </Button>

        <Button layoutX="380.0" layoutY="460.0" onAction="#backButtonOA" prefHeight="40.0" prefWidth="180.0" text="Back to Dashboard">
            <font>
                <Font name="System Bold" size="13.0" />
            </font>
        </Button>

    </children>

</AnchorPane>
