<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.summer.section1.group7.eco_resort.Srijon.controller.logWorkController"
            prefWidth="700" prefHeight="450">
    <children>
        <VBox spacing="10" layoutX="10" layoutY="10" style="-fx-padding:12;">
            <children>
                <Label text="Log Work for Maintenance Request" style="-fx-font-size:18; -fx-font-weight:bold;"/>
                <TextField fx:id="requestIdField" promptText="Request ID"/>
                <TextArea fx:id="descriptionArea" promptText="Work description" prefRowCount="6"/>
                <DatePicker fx:id="datePicker"/>
                <Button text="Add Log" onAction="#onAddLog"/>
                <Label fx:id="infoLabel" text=""/>
            </children>
        </VBox>
    </children>
</AnchorPane>
