<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer.section1.group7.eco_resort.Nazmun.Controller.ChefDashboardController">

    <Label layoutX="220.0" layoutY="30.0" text="Kitchen Dashboard">
        <font>
            <Font name="System Bold" size="24.0" />
        </font>
    </Label>

    <Label fx:id="welcomeLabel" layoutX="220.0" layoutY="75.0" text="Welcome, Chef !!!">
        <font>
            <Font size="14.0" />
        </font>
    </Label>

    <VBox layoutX="20.0" layoutY="20.0" prefWidth="180.0" spacing="12.0">
        <padding>
            <Insets bottom="20.0" left="10.0" right="10.0" top="10.0" />
        </padding>

        <Button fx:id="menuManagementButtonOA" maxWidth="Infinity" onAction="#menuManagementButtonOA" text="Menu Management" />

        <Button fx:id="dailyPreparationButtonOA" maxWidth="Infinity" onAction="#dailyPreparationButtonOA" text="Daily Preparation" />

        <Button fx:id="kitchenStaffButtonOA" maxWidth="Infinity" onAction="#kitchenStaffButtonOA" text="Kitchen Staff" />

        <Button fx:id="kitchenInventoryButtonOA" maxWidth="Infinity" onAction="#kitchenInventoryButtonOA" text="Kitchen Inventory" />

        <Button fx:id="foodQualityButtonOA" maxWidth="Infinity" onAction="#foodQualityButtonOA" text="Food Quality Inspection" />

        <Button fx:id="profitAnalysisButtonOA" maxWidth="Infinity" onAction="#profitAnalysisButtonOA" text="Profit Analysis" />

        <Button fx:id="foodWasteButtonOA" maxWidth="Infinity" onAction="#foodWasteButtonOA" text="Food Waste Log" />

        <Button fx:id="logoutButtonOA" maxWidth="Infinity" onAction="#logoutButtonOA" text="Logout" />
    </VBox>

</AnchorPane>