<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="650.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer.section1.group7.eco_resort.Nazmun.Controller.ManageReservationController">

    <Label layoutX="320.0" layoutY="20.0" text="Reservations">
        <font>
            <Font name="System Bold" size="20.0" />
        </font>
    </Label>

    <TableView fx:id="reservationTableView" layoutX="30.0" layoutY="60.0" prefHeight="260.0" prefWidth="840.0">
        <columns>
            <TableColumn fx:id="reservationIdTC" prefWidth="100.0" text="Reservation ID" />
            <TableColumn fx:id="guestNameTC" prefWidth="150.0" text="Guest Name" />
            <TableColumn fx:id="roomTypeTC" prefWidth="150.0" text="Room Type" />
            <TableColumn fx:id="checkInTC" prefWidth="140.0" text="Check-In" />
            <TableColumn fx:id="checkOutTC" prefWidth="140.0" text="Check-Out" />
            <TableColumn fx:id="statusTC" prefWidth="100.0" text="Status" />
        </columns>
    </TableView>

    <Label layoutX="30.0" layoutY="340.0" text="Add New Reservation">
        <font>
            <Font name="System Bold" size="14.0" />
        </font>
    </Label>

    <VBox layoutX="30.0" layoutY="370.0" prefWidth="840.0" spacing="10.0">
        <padding>
            <Insets bottom="10.0" left="0.0" right="0.0" top="0.0" />
        </padding>
        <HBox spacing="10.0">
            <TextField fx:id="guestNameTF" prefWidth="180.0" promptText="Guest Name" />
            <ComboBox fx:id="roomTypeCB" prefWidth="160.0" promptText="Room Type" />
            <DatePicker fx:id="checkInDP" prefWidth="150.0" promptText="Check-In" />
            <DatePicker fx:id="checkOutDP" prefWidth="150.0" promptText="Check-Out" />
            <Button fx:id="addReservationButtonOA" onAction="#addReservationButtonOA" text="Add Reservation" />
        </HBox>
    </VBox>

    <Button fx:id="cancelReservationButtonOA" layoutX="30.0" layoutY="450.0" onAction="#cancelReservationButtonOA" text="Cancel Selected Reservation" />

    <Button fx:id="backButtonOA" layoutX="30.0" layoutY="580.0" onAction="#backButtonOA" text="Back to Dashboard" />

</AnchorPane>