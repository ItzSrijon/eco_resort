<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="650.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer.section1.group7.eco_resort.Nazmun.Controller.ConductSafetyInspectionController">

    <Label layoutX="300.0" layoutY="20.0" text="Safety Inspection">
        <font>
            <Font name="System Bold" size="20.0" />
        </font>
    </Label>

    <Label layoutX="30.0" layoutY="60.0" text="Add Area to Checklist">
        <font>
            <Font name="System Bold" size="14.0" />
        </font>
    </Label>

    <VBox layoutX="30.0" layoutY="90.0" prefWidth="840.0" spacing="10.0">
        <padding>
            <Insets bottom="10.0" left="0.0" right="0.0" top="0.0" />
        </padding>
        <HBox spacing="10.0">
            <ComboBox fx:id="areaCB" prefWidth="220.0" promptText="Area" />
            <Button fx:id="addAreaButtonOA" onAction="#addAreaButtonOA" text="Add Area" />
        </HBox>
    </VBox>

    <TableView fx:id="inspectionTableView" layoutX="30.0" layoutY="190.0" prefHeight="220.0" prefWidth="840.0">
        <columns>
            <TableColumn fx:id="areaIdTC" prefWidth="90.0" text="Area ID" />
            <TableColumn fx:id="areaNameTC" prefWidth="220.0" text="Area Name" />
            <TableColumn fx:id="statusTC" prefWidth="140.0" text="Status" />
            <TableColumn fx:id="deadlineTC" prefWidth="180.0" text="Deadline (if Fail)" />
        </columns>
    </TableView>

    <Label layoutX="30.0" layoutY="430.0" text="Mark Selected Area">
        <font>
            <Font name="System Bold" size="14.0" />
        </font>
    </Label>

    <VBox layoutX="30.0" layoutY="460.0" prefWidth="840.0" spacing="10.0">
        <padding>
            <Insets bottom="10.0" left="0.0" right="0.0" top="0.0" />
        </padding>
        <HBox spacing="10.0">
            <DatePicker fx:id="deadlineDP" prefWidth="160.0" promptText="Deadline (if Fail)" />
            <Button fx:id="passButtonOA" onAction="#passButtonOA" text="Pass" />
            <Button fx:id="failButtonOA" onAction="#failButtonOA" text="Fail" />
        </HBox>
    </VBox>

    <Label fx:id="summaryLabel" layoutX="30.0" layoutY="560.0" text="Passed: 0   Failed: 0   Pending: 0">
        <font>
            <Font name="System Bold" size="13.0" />
        </font>
    </Label>

    <Button fx:id="backButtonOA" layoutX="30.0" layoutY="600.0" onAction="#backButtonOA" text="Back to Dashboard" />

</AnchorPane>