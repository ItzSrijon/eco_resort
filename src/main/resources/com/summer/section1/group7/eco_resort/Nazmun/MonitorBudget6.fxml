<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700.0" prefWidth="950.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer.section1.group7.eco_resort.Nazmun.Controller.MonitorBudgetController">

    <Label layoutX="330.0" layoutY="20.0" text="Budget &amp; Finance">
        <font>
            <Font name="System Bold" size="20.0" />
        </font>
    </Label>

    <!-- Add Revenue Section -->
    <Label layoutX="30.0" layoutY="60.0" text="Add Revenue">
        <font>
            <Font name="System Bold" size="14.0" />
        </font>
    </Label>

    <HBox layoutX="30.0" layoutY="90.0" spacing="10.0">
        <ComboBox fx:id="revenueSourceCB" prefWidth="180.0" promptText="Source" />
        <TextField fx:id="revenueAmountTF" prefWidth="150.0" promptText="Amount" />
        <Button fx:id="addRevenueButtonOA" onAction="#addRevenueButtonOA" text="Add Revenue" />
    </HBox>

    <!-- Add Expense Section -->
    <Label layoutX="30.0" layoutY="140.0" text="Add Expense">
        <font>
            <Font name="System Bold" size="14.0" />
        </font>
    </Label>

    <HBox layoutX="30.0" layoutY="170.0" spacing="10.0">
        <ComboBox fx:id="expenseCategoryCB" prefWidth="180.0" promptText="Category" />
        <TextField fx:id="expenseAmountTF" prefWidth="150.0" promptText="Amount" />
        <Button fx:id="addExpenseButtonOA" onAction="#addExpenseButtonOA" text="Add Expense" />
    </HBox>

    <!-- Entries TableView -->
    <TableView fx:id="entryTableView" layoutX="30.0" layoutY="220.0" prefHeight="180.0" prefWidth="440.0">
        <columns>
            <TableColumn fx:id="typeTC" prefWidth="120.0" text="Type" />
            <TableColumn fx:id="categoryTC" prefWidth="180.0" text="Category" />
            <TableColumn fx:id="amountTC" prefWidth="140.0" text="Amount" />
        </columns>
    </TableView>

    <!-- Bar Chart -->
    <BarChart fx:id="financeChart" layoutX="490.0" layoutY="220.0" prefHeight="180.0" prefWidth="430.0">
        <xAxis>
            <CategoryAxis side="BOTTOM" />
        </xAxis>
        <yAxis>
            <NumberAxis side="LEFT" />
        </yAxis>
    </BarChart>

    <!-- Summary -->
    <Button fx:id="generateSummaryButtonOA" layoutX="30.0" layoutY="420.0" onAction="#generateSummaryButtonOA" text="Generate Summary" />
    <Label fx:id="summaryLabel" layoutX="200.0" layoutY="424.0" text="Revenue: 0   Expense: 0   Profit/Loss: 0" />

    <!-- Export PDF -->
    <Button fx:id="exportPDFButtonOA" layoutX="30.0" layoutY="470.0" onAction="#exportPDFButtonOA" text="Export PDF" />

    <Button fx:id="backButtonOA" layoutX="30.0" layoutY="620.0" onAction="#backButtonOA" text="Back to Dashboard" />

</AnchorPane>