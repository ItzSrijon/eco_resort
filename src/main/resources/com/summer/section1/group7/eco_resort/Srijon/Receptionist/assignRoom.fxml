<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<AnchorPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.summer.section1.group7.eco_resort.Srijon.controller.assignRoomController"
            prefHeight="300" prefWidth="400">
    <children>
        <VBox spacing="15" alignment="CENTER">
            <Label text="Assign Room" style="-fx-font-size:18;"/>
            <TextField fx:id="reservationIdField" promptText="Reservation ID"/>
            <TextField fx:id="roomNumberField" promptText="Room Number"/>
            <Button text="Assign Room" onAction="#onAssign"/>
            <Label fx:id="infoLabel" text=""/>
        </VBox>
    </children>
</AnchorPane>
