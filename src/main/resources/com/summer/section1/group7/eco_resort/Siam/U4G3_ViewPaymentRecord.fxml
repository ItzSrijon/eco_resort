<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="mainPane" prefHeight="550.0" prefWidth="850.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer.section1.group7.eco_resort.Siam.U4G3_ViewPaymentRecordsController">

    <children>

        <Label alignment="CENTER" layoutX="0.0" layoutY="0.0" prefHeight="60.0" prefWidth="850.0" style="-fx-background-color: grey;" text="View Payment Records">
            <font>
                <Font name="System Bold" size="22.0" />
            </font>
        </Label>

        <Label layoutX="35.0" layoutY="90.0" text="From Date:">
            <font>
                <Font name="System Bold" size="13.0" />
            </font>
        </Label>

        <DatePicker fx:id="fromDateDP" layoutX="120.0" layoutY="85.0" prefWidth="150.0" />

        <Label layoutX="320.0" layoutY="90.0" text="To Date:">
            <font>
                <Font name="System Bold" size="13.0" />
            </font>
        </Label>

        <DatePicker fx:id="toDateDP" layoutX="390.0" layoutY="85.0" prefWidth="150.0" />

        <Button layoutX="590.0" layoutY="84.0" onAction="#loadPaymentsOA" prefWidth="140.0" text="Load Payments">
            <font>
                <Font name="System Bold" size="12.0" />
            </font>
        </Button>

        <TableView fx:id="paymentTV" layoutX="10.0" layoutY="145.0" prefHeight="320.0" prefWidth="830.0">

            <columns>

                <TableColumn fx:id="paymentIdTC" prefWidth="90.0" text="Payment ID" />

                <TableColumn fx:id="guestIdTC" prefWidth="90.0" text="Guest ID" />

                <TableColumn fx:id="guestNameTC" prefWidth="150.0" text="Guest Name" />

                <TableColumn fx:id="invoiceIdTC" prefWidth="100.0" text="Invoice ID" />

                <TableColumn fx:id="amountTC" prefWidth="100.0" text="Amount" />

                <TableColumn fx:id="paymentMethodTC" prefWidth="140.0" text="Payment Method" />

                <TableColumn fx:id="paymentDateTC" prefWidth="150.0" text="Payment Date" />

            </columns>

        </TableView>

        <Button layoutX="335.0" layoutY="490.0" onAction="#backButtonOA" prefHeight="40.0" prefWidth="180.0" text="Back to Dashboard">
            <font>
                <Font name="System Bold" size="13.0" />
            </font>
        </Button>

    </children>

</AnchorPane>
