<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="mainPane"
            prefHeight="620.0"
            prefWidth="750.0"
            style="-fx-background-color:#ECEFF1;"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.summer.section1.group7.eco_resort.Siam.U4G3_ViewPaymentRecordsController">

    <children>

        <!-- Header -->

        <Label alignment="CENTER"
               prefHeight="60"
               prefWidth="750"
               style="-fx-background-color:#263238;
                      -fx-text-fill:white;"
               text="View Payment Records">

            <font>
                <Font name="System Bold" size="22"/>
            </font>

        </Label>

        <!-- Main Card -->

        <VBox layoutX="25"
              layoutY="85"
              prefHeight="500"
              prefWidth="700"
              spacing="18"
              style="-fx-background-color:white;
                     -fx-background-radius:15;
                     -fx-border-radius:15;
                     -fx-border-color:#CFD8DC;">

            <padding>
                <Insets top="18" right="18" bottom="18" left="18"/>
            </padding>

            <children>

                <!-- Filter -->

                <HBox alignment="CENTER"
                      spacing="12">

                    <children>

                        <Label text="From Date">
                            <font>
                                <Font name="System Bold" size="13"/>
                            </font>
                        </Label>

                        <DatePicker fx:id="fromDateDP"
                                    prefWidth="130"/>

                        <Label text="To Date">
                            <font>
                                <Font name="System Bold" size="13"/>
                            </font>
                        </Label>

                        <DatePicker fx:id="toDateDP"
                                    prefWidth="130"/>

                        <Button text="Load Payments"
                                onAction="#loadPaymentsOA"
                                prefWidth="150"
                                prefHeight="38"
                                style="-fx-background-color:#1565C0;
                                       -fx-text-fill:white;
                                       -fx-background-radius:8;">

                            <font>
                                <Font name="System Bold" size="12"/>
                            </font>

                        </Button>

                    </children>

                </HBox>

                <Separator/>

                <!-- Table -->

                <TableView fx:id="paymentTV"
                           prefHeight="320"
                           prefWidth="660">

                    <columns>

                        <TableColumn fx:id="paymentIdTC"
                                     prefWidth="95"
                                     text="Payment ID"/>

                        <TableColumn fx:id="guestIdTC"
                                     prefWidth="95"
                                     text="Guest ID"/>

                        <TableColumn fx:id="guestNameTC"
                                     prefWidth="150"
                                     text="Guest Name"/>

                        <TableColumn fx:id="amountTC"
                                     prefWidth="90"
                                     text="Amount"/>

                        <TableColumn fx:id="paymentMethodTC"
                                     prefWidth="120"
                                     text="Method"/>

                        <TableColumn fx:id="paymentDateTC"
                                     prefWidth="110"
                                     text="Date"/>

                    </columns>

                </TableView>

                <Separator/>

                <!-- Bottom Button -->

                <HBox alignment="CENTER">

                    <children>

                        <Button text="Back to Dashboard"
                                onAction="#backButtonOA"
                                prefHeight="42"
                                prefWidth="210"
                                style="-fx-background-color:#616161;
                                       -fx-text-fill:white;
                                       -fx-background-radius:8;">

                            <font>
                                <Font name="System Bold" size="13"/>
                            </font>

                        </Button>

                    </children>

                </HBox>

            </children>

        </VBox>

    </children>

</AnchorPane>