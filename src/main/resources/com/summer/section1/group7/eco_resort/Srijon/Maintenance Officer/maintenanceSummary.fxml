<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.summer.section1.group7.eco_resort.Srijon.controller.maintenanceSummaryController"
            prefWidth="700" prefHeight="450">
    <children>
        <VBox spacing="12" layoutX="10" layoutY="10" style="-fx-padding:12;">
            <children>
                <Label text="Maintenance Summary" style="-fx-font-size:18; -fx-font-weight:bold;"/>
                <BarChart fx:id="summaryBarChart" prefHeight="300" prefWidth="660">
                    <xAxis>
                        <CategoryAxis fx:id="categoryAxis" label="Status"/>
                    </xAxis>
                    <yAxis>
                        <NumberAxis fx:id="numberAxis" label="Count"/>
                    </yAxis>
                </BarChart>
                <Label fx:id="totalLabel" text="Total requests: 0"/>
                <Label fx:id="completedLabel" text="Completed: 0"/>
                <Label fx:id="pendingLabel" text="Pending/In Progress: 0"/>
                <Button text="Refresh Summary" onAction="#onRefresh"/>
                <Button text="Export Summary to PDF" onAction="#onExportPdf"/>
            </children>
        </VBox>
    </children>
</AnchorPane>
