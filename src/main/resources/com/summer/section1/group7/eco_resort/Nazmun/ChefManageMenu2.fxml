<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer.section1.group7.eco_resort.Nazmun.Controller.ChefManageMenuController">

    <Label layoutX="330.0" layoutY="20.0" text="Menu Management">
        <font>
            <Font name="System Bold" size="20.0" />
        </font>
    </Label>

    <!-- Menu TableView -->
    <TableView fx:id="menuTableView" layoutX="30.0" layoutY="60.0" prefHeight="220.0" prefWidth="840.0">
        <columns>
            <TableColumn fx:id="itemIdTC" prefWidth="100.0" text="Item ID" />
            <TableColumn fx:id="itemNameTC" prefWidth="240.0" text="Name" />
            <TableColumn fx:id="itemCategoryTC" prefWidth="220.0" text="Category" />
            <TableColumn fx:id="itemPriceTC" prefWidth="120.0" text="Price" />
        </columns>
    </TableView>

    <!-- Add New Menu Item Section -->
    <Label layoutX="30.0" layoutY="300.0" text="Add New Menu Item">
        <font>
            <Font name="System Bold" size="14.0" />
        </font>
    </Label>

    <VBox layoutX="30.0" layoutY="330.0" prefWidth="840.0" spacing="10.0">
        <padding>
            <Insets bottom="10.0" left="0.0" right="0.0" top="0.0" />
        </padding>

        <HBox spacing="10.0">
            <TextField fx:id="itemNameTF" prefWidth="220.0" promptText="Item Name" />
            <ComboBox fx:id="itemCategoryCB" prefWidth="160.0" promptText="Category" />
            <TextField fx:id="itemPriceTF" prefWidth="120.0" promptText="Price" />
            <Button fx:id="addMenuItemButtonOA" onAction="#addMenuItemButtonOA" text="Add Item" />
        </HBox>

        <Label fx:id="addItemMessageLabel" textFill="RED" />
    </VBox>

    <!-- Edit Price Section -->
    <Label layoutX="30.0" layoutY="430.0" text="Edit Price of Selected Item">
        <font>
            <Font name="System Bold" size="14.0" />
        </font>
    </Label>

    <VBox layoutX="30.0" layoutY="460.0" prefWidth="840.0" spacing="10.0">
        <padding>
            <Insets bottom="10.0" left="0.0" right="0.0" top="0.0" />
        </padding>

        <HBox spacing="10.0">
            <TextField fx:id="editPriceTF" prefWidth="150.0" promptText="New Price" />
            <Button fx:id="editPriceButtonOA" onAction="#editPriceButtonOA" text="Update Price" />
        </HBox>

        <Label fx:id="editPriceMessageLabel" textFill="RED" />
    </VBox>

    <Button fx:id="backButtonOA" layoutX="30.0" layoutY="540.0" onAction="#backButtonOA" text="Back to Dashboard" />

</AnchorPane>
