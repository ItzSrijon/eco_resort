<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="420.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer.section1.group7.eco_resort.Piya.controller.UpdateProfileController">

    <children>

        <Label layoutX="210.0" layoutY="25.0" text="Update Profile">

            <font>
                <Font name="System Bold" size="18.0" />
            </font>

        </Label>


        <Label layoutX="80.0" layoutY="90.0" text="Name :" />

        <TextField fx:id="nameTF" editable="false" layoutX="200.0" layoutY="85.0" />



        <Label layoutX="80.0" layoutY="130.0" text="Username :" />

        <TextField fx:id="usernameTF" editable="false" layoutX="200.0" layoutY="126.0" />



        <Label layoutX="80.0" layoutY="170.0" text="Email :" />

        <TextField fx:id="emailTF" layoutX="200.0" layoutY="165.0" />



        <Label layoutX="80.0" layoutY="210.0" text="Phone Number :" />

        <TextField fx:id="phoneTF" layoutX="200.0" layoutY="205.0" />



        <Label layoutX="80.0" layoutY="250.0" text="Password :" />

        <PasswordField fx:id="passwordPF" layoutX="200.0" layoutY="245.0" />



        <Button layoutX="96.0" layoutY="300.0" onAction="#updateProfileButtonOA" prefHeight="27.0" prefWidth="107.0" text="Update Profile" textAlignment="CENTER" wrapText="true" />



        <Label fx:id="messageLabel" layoutX="50.0" layoutY="385.0" prefWidth="300.0" />



        <Button layoutX="399.0" layoutY="300.0" onAction="#backButtonOA" prefHeight="27.0" prefWidth="87.0" text="Back" />
      <Button layoutX="253.0" layoutY="300.0" mnemonicParsing="false" onAction="#refreshButtonOA" prefHeight="27.0" prefWidth="94.0" text="Refresh" />


    </children>

</AnchorPane>
