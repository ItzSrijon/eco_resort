<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer.section1.group7.eco_resort.Nazmun.Controller.ManagerDashboardController">

    <Label layoutX="220.0" layoutY="30.0" text="Manager Dashboard">
        <font>
            <Font name="System Bold" size="24.0" />
        </font>
    </Label>

    <Label fx:id="welcomeLabel" layoutX="220.0" layoutY="75.0" text="Welcome, Manager !!!">
        <font>
            <Font size="14.0" />
        </font>
    </Label>

    <VBox layoutX="20.0" layoutY="20.0" prefWidth="180.0" spacing="12.0">
        <padding>
            <Insets bottom="20.0" left="10.0" right="10.0" top="10.0" />
        </padding>

        <Button fx:id="reservationsButtonOA" maxWidth="Infinity" onAction="#reservationsButtonOA" text="Reservations" />

        <Button fx:id="roomManagementButtonOA" maxWidth="Infinity" onAction="#roomManagementButtonOA" text="Room Management" />

        <Button fx:id="menuApprovalButtonOA" maxWidth="Infinity" onAction="#menuApprovalButtonOA" text="Menu Approval" />

        <Button fx:id="staffManagementButtonOA" maxWidth="Infinity" onAction="#staffManagementButtonOA" text="Staff Management" />

        <Button fx:id="budgetFinanceButtonOA" maxWidth="Infinity" onAction="#budgetFinanceButtonOA" text="Budget &amp; Finance" />

        <Button fx:id="safetyInspectionButtonOA" maxWidth="Infinity" onAction="#safetyInspectionButtonOA" text="Safety Inspection" />

        <Button fx:id="ecoMetricsButtonOA" maxWidth="Infinity" onAction="#ecoMetricsButtonOA" text="Eco Metrics" />

        <Button fx:id="logoutButtonOA" maxWidth="Infinity" onAction="#logoutButtonOA" text="Logout" />
    </VBox>

</AnchorPane>