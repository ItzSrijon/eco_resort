<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="mainPane" prefHeight="620.0" prefWidth="750.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer.section1.group7.eco_resort.Siam.U4G5_GenerateGuestInvoiceController">

    <children>

        <Label alignment="CENTER" layoutX="0.0" layoutY="0.0" prefHeight="60.0" prefWidth="750.0" style="-fx-background-color:#263238; -fx-text-fill:white;" text="Generate Guest Invoice">

            <font>
                <Font name="System Bold" size="24.0" />
            </font>

        </Label>

        <AnchorPane layoutX="55.0" layoutY="90.0" prefHeight="420.0" prefWidth="640.0" style="-fx-background-color:white; -fx-background-radius:12; -fx-border-radius:12; -fx-border-color:lightgray;">

            <children>

                <Label layoutX="35.0" layoutY="30.0" text="Guest ID">

                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>

                </Label>

                <TextField fx:id="guestIdTF" layoutX="180.0" layoutY="25.0" prefWidth="220.0" />

                <Button layoutX="420.0" layoutY="24.0" onAction="#loadGuestOA" prefHeight="26.0" prefWidth="120.0" style="-fx-background-color:#1976D2; -fx-text-fill:white; -fx-background-radius:8;" text="Load Guest">

                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>

                </Button>

                <Label layoutX="35.0" layoutY="90.0" text="Guest Name">

                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>

                </Label>

                <TextField fx:id="guestNameTF" editable="false" layoutX="180.0" layoutY="85.0" prefWidth="220.0" />

                <Label layoutX="35.0" layoutY="150.0" text="Total Bill">

                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>

                </Label>

                <TextField fx:id="totalBillTF" layoutX="180.0" layoutY="145.0" prefWidth="220.0" promptText="Enter Total Bill" />

                <Label layoutX="35.0" layoutY="210.0" text="Total Paid">

                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>

                </Label>

                <TextField fx:id="totalPaidTF" layoutX="180.0" layoutY="205.0" prefWidth="220.0" promptText="Enter Total Paid" />

                <Label layoutX="35.0" layoutY="270.0" text="Due Payment">

                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>

                </Label>

                <TextField fx:id="duePaymentTF" editable="false" layoutX="180.0" layoutY="265.0" prefWidth="220.0" promptText="Will be Filled Automactically" />

            </children>

        </AnchorPane>

        <Button layoutX="92.0" layoutY="540.0" onAction="#generateInvoiceOA" prefHeight="40.0" prefWidth="170.0" style="-fx-background-color:#2E7D32; -fx-text-fill:white; -fx-background-radius:8;" text="Generate Invoice">

            <font>
                <Font name="System Bold" size="13.0" />
            </font>

        </Button>
      <Button layoutX="314.0" layoutY="540.0" onAction="#viewInvoiceOA" prefHeight="40.0" prefWidth="170.0" style="-fx-background-color: purple; -fx-text-fill: white; -fx-background-radius: 8;" text="View Invoice">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Button>

              <Button layoutX="518.0" layoutY="535.0" onAction="#backToDashboardOA" prefHeight="40.0" prefWidth="170.0" style="-fx-background-color:#616161; -fx-text-fill:white; -fx-background-radius:8;" text="Back to Dashboard">

                  <font>
                <Font name="System Bold" size="13.0" />
            </font>

              </Button>

    </children>

</AnchorPane>
