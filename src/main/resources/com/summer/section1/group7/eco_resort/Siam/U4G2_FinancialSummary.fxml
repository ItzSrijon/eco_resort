<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="mainPane"
            prefHeight="650.0"
            prefWidth="750.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.summer.section1.group7.eco_resort.Siam.U4G2_GenerateFinancialSummaryController">

    <children>

        <Label alignment="CENTER"
               layoutX="0"
               layoutY="0"
               prefWidth="750"
               prefHeight="60"
               text="Generate Financial Summary Report"
               style="-fx-background-color:#263238; -fx-text-fill:white;">

            <font>
                <Font name="System Bold" size="24"/>
            </font>

        </Label>

        <AnchorPane layoutX="45"
                    layoutY="80"
                    prefWidth="660"
                    prefHeight="450"
                    style="-fx-background-color:white;
                           -fx-background-radius:12;
                           -fx-border-radius:12;
                           -fx-border-color:lightgray;">

            <children>

                <Label layoutX="35" layoutY="35" text="Guest Payment Total">
                    <font><Font name="System Bold" size="14"/></font>
                </Label>

                <TextField fx:id="guestPaymentTF"
                           layoutX="250"
                           layoutY="30"
                           prefWidth="220"
                           promptText="Enter Total Guest Payment"/>

                <Label layoutX="35" layoutY="90" text="Supplier Payment Total">
                    <font><Font name="System Bold" size="14"/></font>
                </Label>

                <TextField fx:id="supplierPaymentTF"
                           layoutX="250"
                           layoutY="85"
                           prefWidth="220"
                           promptText="Enter Total Supplier Payment"/>

                <Label layoutX="35" layoutY="145" text="Employee Salary Total">
                    <font><Font name="System Bold" size="14"/></font>
                </Label>

                <TextField fx:id="employeeSalaryTF"
                           layoutX="250"
                           layoutY="140"
                           prefWidth="220"
                           promptText="Enter Total Salary"/>

                <Label layoutX="35" layoutY="200" text="Total Transactions">
                    <font><Font name="System Bold" size="14"/></font>
                </Label>

                <TextField fx:id="transactionTF"
                           layoutX="250"
                           layoutY="195"
                           prefWidth="220"
                           promptText="Enter Total Transactions"/>

                <Separator layoutX="20"
                           layoutY="255"
                           prefWidth="620"/>

                <Label layoutX="35"
                       layoutY="285"
                       text="Total Income">

                    <font>
                        <Font name="System Bold" size="14"/>
                    </font>

                </Label>

                <TextField fx:id="incomeTF"
                           editable="false"
                           layoutX="250"
                           layoutY="280"
                           prefWidth="220"/>

                <Label layoutX="35"
                       layoutY="340"
                       text="Total Expense">

                    <font>
                        <Font name="System Bold" size="14"/>
                    </font>

                </Label>

                <TextField fx:id="expenseTF"
                           editable="false"
                           layoutX="250"
                           layoutY="335"
                           prefWidth="220"/>

                <Label layoutX="35"
                       layoutY="395"
                       text="Profit / Loss">

                    <font>
                        <Font name="System Bold" size="14"/>
                    </font>

                </Label>

                <TextField fx:id="profitTF"
                           editable="false"
                           layoutX="250"
                           layoutY="390"
                           prefWidth="220"/>

            </children>

        </AnchorPane>

        <Button layoutX="70"
                layoutY="570"
                prefWidth="150"
                prefHeight="40"
                text="Generate Report"
                onAction="#generateReportOA"
                style="-fx-background-color:#1976D2;
                       -fx-text-fill:white;
                       -fx-background-radius:8;">

            <font>
                <Font name="System Bold" size="13"/>
            </font>

        </Button>

        <Button layoutX="250"
                layoutY="570"
                prefWidth="150"
                prefHeight="40"
                text="Save Report"
                onAction="#saveReportOA"
                style="-fx-background-color:#2E7D32;
                       -fx-text-fill:white;
                       -fx-background-radius:8;">

            <font>
                <Font name="System Bold" size="13"/>
            </font>

        </Button>

        <Button layoutX="430"
                layoutY="570"
                prefWidth="150"
                prefHeight="40"
                text="View Report"
                onAction="#viewReportOA"
                style="-fx-background-color:#FF9800;
                       -fx-text-fill:white;
                       -fx-background-radius:8;">

            <font>
                <Font name="System Bold" size="13"/>
            </font>

        </Button>

        <Button layoutX="610"
                layoutY="570"
                prefWidth="120"
                prefHeight="40"
                text="Back"
                onAction="#backToDashboardOA"
                style="-fx-background-color:#616161;
                       -fx-text-fill:white;
                       -fx-background-radius:8;">

            <font>
                <Font name="System Bold" size="13"/>
            </font>

        </Button>

    </children>

</AnchorPane>