<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.summer.section1.group7.eco_resort.Srijon.controller.updateEquipmentController"
            prefWidth="700" prefHeight="450">

    <children>
        <VBox spacing="12" layoutX="10" layoutY="10" prefWidth="680" prefHeight="430" style="-fx-padding:12;">
            <children>
                <Label text="Equipment Management" style="-fx-font-size:18; -fx-font-weight:bold;"/>

                <HBox spacing="10">
                    <children>
                        <TextField fx:id="equipmentIdField" promptText="Equipment ID (auto for new)" prefWidth="180"/>
                        <TextField fx:id="nameField" promptText="Equipment Name" prefWidth="220"/>
                        <ComboBox fx:id="conditionCombo" prefWidth="180" promptText="Condition"/>
                    </children>
                </HBox>

                <HBox spacing="10">
                    <children>
                        <Button text="Add" onAction="#onAdd" />
                        <Button text="Update" onAction="#onUpdate" />
                        <Button text="Delete" onAction="#onDelete" />
                        <Button text="Refresh" onAction="#onRefresh" />
                    </children>
                </HBox>

                <TableView fx:id="equipmentTable" prefHeight="260">
                    <columns>
                        <TableColumn fx:id="colId" text="Equipment ID" prefWidth="160"/>
                        <TableColumn fx:id="colName" text="Name" prefWidth="260"/>
                        <TableColumn fx:id="colCondition" text="Condition" prefWidth="200"/>
                    </columns>
                </TableView>

                <Label fx:id="infoLabel" text="" />
            </children>
        </VBox>
    </children>
</AnchorPane>
