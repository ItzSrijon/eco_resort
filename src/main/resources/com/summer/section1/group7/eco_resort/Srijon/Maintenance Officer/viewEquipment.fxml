<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.summer.section1.group7.eco_resort.Srijon.controller.viewEquipmentController"
            prefWidth="700" prefHeight="450">
    <children>
        <VBox spacing="10" layoutX="10" layoutY="10" style="-fx-padding:12;">
            <children>
                <Label text="Equipment List" style="-fx-font-size:18; -fx-font-weight:bold;"/>
                <TableView fx:id="equipmentTable" prefHeight="320">
                    <columns>
                        <TableColumn fx:id="colId" text="Equipment ID" prefWidth="180"/>
                        <TableColumn fx:id="colName" text="Name" prefWidth="320"/>
                        <TableColumn fx:id="colCondition" text="Condition" prefWidth="180"/>
                    </columns>
                </TableView>
                <HBox spacing="10">
                    <children>
                        <Button text="Refresh" onAction="#onRefresh"/>
                        <Button text="Export Summary" onAction="#onExportSummary"/>
                    </children>
                </HBox>
                <Label fx:id="infoLabel" text=""/>
            </children>
        </VBox>
    </children>
</AnchorPane>
