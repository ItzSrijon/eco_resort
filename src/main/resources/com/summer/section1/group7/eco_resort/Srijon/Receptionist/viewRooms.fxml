<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<AnchorPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.summer.section1.group7.eco_resort.Srijon.controller.viewRoomsController"
            prefHeight="400" prefWidth="600">
    <children>
        <VBox spacing="15">
            <Label text="Room List" style="-fx-font-size:18;"/>
            <TableView fx:id="roomTable">
                <columns>
                    <TableColumn fx:id="colRoomNumber" text="Room Number"/>
                    <TableColumn fx:id="colRoomType" text="Room Type"/>
                    <TableColumn fx:id="colStatus" text="Status"/>
                </columns>
            </TableView>
            <Button text="Refresh" onAction="#onRefresh"/>
        </VBox>
    </children>
</AnchorPane>
