<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="mainPane" prefHeight="550.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer.section1.group7.eco_resort.Siam.U3G7_AssignFitnessPackageController">

    <children>

        <Label alignment="CENTER" layoutX="0.0" layoutY="0.0" prefHeight="60.0" prefWidth="700.0" style="-fx-background-color: grey;" text="Assign Fitness Package">

            <font>
                <Font name="System Bold" size="22.0" />
            </font>
        </Label>

        <Label layoutX="40.0" layoutY="90.0" text="Guest ID:">
            <font>
                <Font name="System Bold" size="13.0" />
            </font>
        </Label>

        <TextField fx:id="guestIdTF" layoutX="170.0" layoutY="85.0" prefWidth="180.0" />

        <Button layoutX="380.0" layoutY="84.0" onAction="#searchGuestOA" prefWidth="120.0" text="Search Guest">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Button>

        <Label layoutX="40.0" layoutY="145.0" text="Guest Name:">
            <font>
                <Font name="System Bold" size="13.0" />
            </font>
        </Label>

        <TextField fx:id="guestNameTF" editable="false" layoutX="170.0" layoutY="140.0" prefWidth="250.0" />

        <Label layoutX="40.0" layoutY="195.0" text="Phone Number:">
            <font>
                <Font name="System Bold" size="13.0" />
            </font>
        </Label>

        <TextField fx:id="phoneTF" editable="false" layoutX="170.0" layoutY="190.0" prefWidth="250.0" />

        <Label layoutX="40.0" layoutY="245.0" text="Current Package:">
            <font>
                <Font name="System Bold" size="13.0" />
            </font>
        </Label>

        <TextField fx:id="currentPackageTF" editable="false" layoutX="170.0" layoutY="240.0" prefWidth="180.0" />

        <Label layoutX="40.0" layoutY="295.0" text="Fitness Package:">
            <font>
                <Font name="System Bold" size="13.0" />
            </font>
        </Label>

        <ComboBox fx:id="newFitnessPackageCB" layoutX="170.0" layoutY="290.0" prefWidth="180.0" />

        <Label layoutX="40.0" layoutY="345.0" text="Start Date:">
            <font>
                <Font name="System Bold" size="13.0" />
            </font>
        </Label>

        <TextField fx:id="startDateTF" editable="false" layoutX="170.0" layoutY="340.0" prefWidth="180.0" />

        <Label layoutX="40.0" layoutY="395.0" text="Expiry Date:">
            <font>
                <Font name="System Bold" size="13.0" />
            </font>
        </Label>

        <TextField fx:id="expiryDateTF" editable="false" layoutX="170.0" layoutY="390.0" prefWidth="180.0" />

        <Button layoutX="150.0" layoutY="470.0" onAction="#assignPackageOA" prefHeight="40.0" prefWidth="170.0" text="Assign Package">
            <font>
                <Font name="System Bold" size="13.0" />
            </font>
        </Button>

        <Button layoutX="380.0" layoutY="470.0" onAction="#backButtonOA" prefHeight="40.0" prefWidth="180.0" text="Back to Dashboard">
            <font>
                <Font name="System Bold" size="13.0" />
            </font>
        </Button>

    </children>

</AnchorPane>
