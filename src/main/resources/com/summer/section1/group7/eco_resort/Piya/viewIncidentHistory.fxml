      </Label>
      <Label layoutX="269.0" layoutY="41.0" text="Check Incident Record !!" textFill="#b47bb3" />
      <VBox layoutX="11.0" layoutY="79.0" prefHeight="360.0" prefWidth="655.0" style="-fx-background-color: black;">
