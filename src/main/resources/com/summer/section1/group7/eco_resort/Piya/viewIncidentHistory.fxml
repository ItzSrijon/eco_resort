<AnchorPane prefHeight="400.0" prefWidth="689.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer.section1.group7.eco_resort.Piya.controller.ViewIncidentsController">
   <children>
      <HBox prefHeight="69.0" prefWidth="689.0" style="-fx-background-color: black;" />
      <Label layoutX="272.0" layoutY="14.0" prefHeight="27.0" prefWidth="206.0" text="View Incidents" textFill="#d199ce">
         <font>
            <Font name="System Bold" size="18.0" />
