<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.summer.section1.group7.eco_resort.Srijon.controller.maintenanceDashboardController"
            prefWidth="900" prefHeight="600">

    <children>
        <HBox prefWidth="900" prefHeight="600">
            <VBox spacing="10" prefWidth="200" style="-fx-background-color:#e0f7fa; -fx-padding:10;">
                <Label text="Maintenance Dashboard" style="-fx-font-size:16; -fx-font-weight:bold;"/>
                <Button fx:id="btnCreateRequest" text="Create Request" onAction="#openCreateRequest"/>
                <Button fx:id="btnViewRequests" text="View Requests" onAction="#openViewRequests"/>
                <Button fx:id="btnUpdateRepairStatus" text="Update Repair Status" onAction="#openUpdateRepairStatus"/>
                <Button fx:id="btnUpdateEquipment" text="Update Equipment" onAction="#openUpdateEquipment"/>
                <Button fx:id="btnViewEquipment" text="View Equipment" onAction="#openViewEquipment"/>
                <Button fx:id="btnLogWork" text="Log Work" onAction="#openLogWork"/>
                <Button fx:id="btnSummary" text="Maintenance Summary" onAction="#openSummary"/>
                <Button fx:id="btnCloseRequest" text="Close Request" onAction="#openCloseRequest"/>
                <Button fx:id="btnLogout" text="LogOut" onAction="#openLogout"/>
            </VBox>

            <AnchorPane fx:id="contentArea" prefWidth="700" prefHeight="600"/>
        </HBox>
    </children>
</AnchorPane>
