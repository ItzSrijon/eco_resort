<AnchorPane prefHeight="475.0" prefWidth="533.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer.section1.group7.eco_resort.Piya.controller.CheckOutRecordController">
