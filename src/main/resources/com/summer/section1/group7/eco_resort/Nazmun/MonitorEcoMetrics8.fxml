<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer.section1.group7.eco_resort.Nazmun.Controller.MonitorEcoMetricsController">

    <Label layoutX="330.0" layoutY="20.0" text="Eco Metrics">
        <font>
            <Font name="System Bold" size="20.0" />
        </font>
    </Label>

    <Label layoutX="30.0" layoutY="60.0" text="Add Metric Record">
        <font>
            <Font name="System Bold" size="14.0" />
        </font>
    </Label>

    <VBox layoutX="30.0" layoutY="90.0" prefWidth="840.0" spacing="10.0">
        <padding>
            <Insets bottom="10.0" left="0.0" right="0.0" top="0.0" />
        </padding>
        <HBox spacing="10.0">
            <ComboBox fx:id="metricTypeCB" prefWidth="160.0" promptText="Metric Type" />
            <TextField fx:id="usageTF" prefWidth="150.0" promptText="Current Usage" />
            <TextField fx:id="targetTF" prefWidth="150.0" promptText="Target Value" />
            <Button fx:id="addRecordButtonOA" onAction="#addRecordButtonOA" text="Add Record" />
        </HBox>
    </VBox>

    <TableView fx:id="metricTableView" layoutX="30.0" layoutY="200.0" prefHeight="280.0" prefWidth="840.0">
        <columns>
            <TableColumn fx:id="metricIdTC" prefWidth="90.0" text="Metric ID" />
            <TableColumn fx:id="metricTypeTC" prefWidth="150.0" text="Type" />
            <TableColumn fx:id="usageTC" prefWidth="150.0" text="Usage" />
            <TableColumn fx:id="targetTC" prefWidth="150.0" text="Target" />
            <TableColumn fx:id="statusTC" prefWidth="150.0" text="Status" />
        </columns>
    </TableView>

    <Button fx:id="backButtonOA" layoutX="30.0" layoutY="510.0" onAction="#backButtonOA" text="Back to Dashboard" />

</AnchorPane>