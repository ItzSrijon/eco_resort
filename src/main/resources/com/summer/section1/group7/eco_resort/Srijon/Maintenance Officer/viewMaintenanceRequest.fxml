<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.Button?>
<AnchorPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.summer.section1.group7.eco_resort.Srijon.controller.viewMaintenanceRequestController"
            prefHeight="400" prefWidth="600">
    <children>
        <VBox spacing="10">
            <Label text="Maintenance Requests" style="-fx-font-size:18;"/>
            <TableView fx:id="requestTable">
                <columns>
                    <TableColumn fx:id="colId" text="Request ID"/>
                    <TableColumn fx:id="colRoom" text="Room"/>
                    <TableColumn fx:id="colIssue" text="Issue"/>
                    <TableColumn fx:id="colStatus" text="Status"/>
                </columns>
            </TableView>
            <Button text="Refresh" onAction="#onRefresh"/>
        </VBox>
    </children>
</AnchorPane>
