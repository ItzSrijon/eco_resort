      <Label alignment="CENTER" contentDisplay="CENTER" layoutX="211.0" layoutY="14.0" prefHeight="34.0" prefWidth="207.0" text="Search Reservation" textAlignment="CENTER" textFill="#b89756">
         <font>
            <Font name="System Bold" size="19.0" />
