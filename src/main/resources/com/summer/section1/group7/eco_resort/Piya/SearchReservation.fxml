            <TableColumn fx:id="checkInDateTC" prefWidth="110.5" text="Check-In Date" />
            <TableColumn fx:id="checkInOutTC" minWidth="0.0" prefWidth="102.5" text="Check-Out Date" />
            <TableColumn fx:id="bookingStatusTC" minWidth="0.0" prefWidth="96.5" text="BookingStatus" />
