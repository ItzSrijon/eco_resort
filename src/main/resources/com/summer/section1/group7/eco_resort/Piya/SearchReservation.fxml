      </Label>
      <VBox layoutX="9.0" layoutY="63.0" prefHeight="362.0" prefWidth="633.0" style="-fx-background-color: black;" />
      <Label fx:id="messageLabel" layoutX="347.0" layoutY="355.0" prefHeight="34.0" prefWidth="255.0" />
      <TableView fx:id="searchReservationTV" layoutX="35.0" layoutY="174.0" prefHeight="152.0" prefWidth="600.0">
        <columns>
          <TableColumn fx:id="guestNameTC" prefWidth="89.0" text="Guest Name" />
          <TableColumn fx:id="reservationIdTC" prefWidth="108.0" text="Reservation ID" />
