<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="mainPane" prefHeight="620.0" prefWidth="750.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer.section1.group7.eco_resort.Siam.ViewInvoiceController">

    <children>

        <Label alignment="CENTER" layoutX="0.0" layoutY="0.0" prefHeight="60.0" prefWidth="750.0" style="-fx-background-color:#263238; -fx-text-fill:white;" text="Guest Invoice">

            <font>
                <Font name="System Bold" size="24.0" />
            </font>

        </Label>

        <TableView fx:id="invoiceTV" layoutX="20.0" layoutY="90.0" prefHeight="420.0" prefWidth="710.0">

            <columns>

                <TableColumn fx:id="guestIdTC" prefWidth="110.0" text="Guest ID" />

                <TableColumn fx:id="guestNameTC" prefWidth="170.0" text="Guest Name" />

                <TableColumn fx:id="totalBillTC" prefWidth="140.0" text="Total Bill" />

                <TableColumn fx:id="totalPaidTC" prefWidth="140.0" text="Total Paid" />

                <TableColumn fx:id="duePaymentTC" prefWidth="150.0" text="Due Payment" />

            </columns>

        </TableView>

        <Button layoutX="525.0" layoutY="539.0" onAction="#backOA" prefHeight="40.0" prefWidth="170.0" style="-fx-background-color:#616161; -fx-text-fill:white; -fx-background-radius:8;" text="Back">

            <font>
                <Font name="System Bold" size="13.0" />
            </font>

        </Button>
      <Button layoutX="148.0" layoutY="539.0" onAction="#loadButtonOA" prefHeight="40.0" prefWidth="170.0" style="-fx-background-color: purple; -fx-text-fill: white; -fx-background-radius: 8;" text="Load">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Button>

    </children>

</AnchorPane>
