<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="430.0" prefWidth="600.0"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.summer.section1.group7.eco_resort.Piya.controller.LostAndFoundController">

    <children>

        <Label layoutX="170.0" layoutY="15.0"
               text="Report Lost And Found Items">
            <font>
                <Font name="System Bold" size="16.0"/>
            </font>
        </Label>


        <Label layoutX="25.0" layoutY="70.0"
               text="Item ID :" />

        <TextField fx:id="itemIdTF"
                   layoutX="90.0"
                   layoutY="66.0"/>


        <Label layoutX="300.0" layoutY="70.0"
               text="Item Name :" />

        <TextField fx:id="itemNameTF"
                   layoutX="390.0"
                   layoutY="66.0"/>


        <Label layoutX="25.0" layoutY="120.0"
               text="Category :" />

        <ComboBox fx:id="categoryCB"
                  layoutX="90.0"
                  layoutY="116.0"
                  prefWidth="150.0"/>


        <Label layoutX="300.0" layoutY="120.0"
               text="Location :" />

        <TextField fx:id="locationTF"
                   layoutX="390.0"
                   layoutY="116.0"/>


        <Label layoutX="25.0" layoutY="170.0"
               text="Description :" />

        <TextArea fx:id="descriptionTA"
                  layoutX="110.0"
                  layoutY="165.0"
                  prefHeight="120.0"
                  prefWidth="250.0"/>


        <Button layoutX="220.0"
                layoutY="315.0"
                mnemonicParsing="false"
                onAction="#saveButtonOA"
                prefWidth="90.0"
                text="Save"/>


        <Button layoutX="25.0"
                layoutY="370.0"
                mnemonicParsing="false"
                onAction="#backButtonOA"
                prefWidth="90.0"
                text="Back"/>


        <Label fx:id="messageLabel"
               layoutX="350.0"
               layoutY="320.0"
               prefHeight="50.0"
               prefWidth="200.0"/>

    </children>

</AnchorPane>