<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.effect.InnerShadow?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="615.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer.section1.group7.eco_resort.Piya.controller.LostAndFoundController">

    <children>


        <Label fx:id="messageLabel" layoutX="254.0" layoutY="363.0" prefHeight="50.0" prefWidth="200.0" />
      <HBox layoutX="-4.0" layoutY="3.0" prefHeight="50.0" prefWidth="608.0" style="-fx-background-color: black;" />

        <Label layoutX="170.0" layoutY="15.0" text="Report Lost And Found Items" textFill="#7ead77">
            <font>
                <Font name="System Bold" size="16.0" />
            </font>
        </Label>
      <VBox layoutX="10.0" layoutY="59.0" prefHeight="438.0" prefWidth="595.0" style="-fx-background-color: black;" />


        <Label layoutX="38.0" layoutY="98.0" text="Item Name :" textFill="#4b8147" />

        <TextField fx:id="itemNameTF" layoutX="115.0" layoutY="94.0" promptText="Enter Item Name" />


        <Label layoutX="300.0" layoutY="98.0" text="Category :" textFill="#3f8540" />

        <ComboBox fx:id="categoryCB" layoutX="375.0" layoutY="94.0" prefWidth="150.0" promptText="Choose category" />


        <Label layoutX="32.0" layoutY="153.0" text="Location :" textFill="#538a3f" />

        <TextField fx:id="locationTF" layoutX="115.0" layoutY="149.0" promptText="Enter the Location" />


        <Label layoutX="321.0" layoutY="184.0" text="Description :" textFill="#4fa959" />

        <TextArea fx:id="descriptionTA" layoutX="222.0" layoutY="212.0" prefHeight="120.0" prefWidth="250.0" promptText="Write briefly about Lost and Found Items !!" />


        <Button layoutX="93.0" layoutY="363.0" mnemonicParsing="false" onAction="#saveButtonOA" prefWidth="90.0" text="Save">
         <effect>
            <DropShadow spread="0.43">
               <input>
                  <InnerShadow />
               </input>
               <color>
                  <Color red="0.2132980078458786" green="0.6184210777282715" blue="0.3145787715911865" />
               </color>
            </DropShadow>
         </effect></Button>


        <Button layoutX="39.0" layoutY="420.0" mnemonicParsing="false" onAction="#backButtonOA" prefWidth="90.0" text="Back">
         <effect>
            <DropShadow spread="0.51">
               <input>
                  <InnerShadow />
               </input>
               <color>
                  <Color red="0.23282164335250854" green="0.5131579041481018" blue="0.2935611605644226" />
               </color>
            </DropShadow>
         </effect></Button>

    </children>

</AnchorPane>
