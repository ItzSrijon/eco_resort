<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="mainPane"
            prefHeight="620.0"
            prefWidth="750.0"
            style="-fx-background-color:#ECEFF1;"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.summer.section1.group7.eco_resort.Siam.U3G5_EquipmentUsageController">

    <children>

        <Label alignment="CENTER"
               prefHeight="60"
               prefWidth="750"
               text="Equipment Usage"
               style="-fx-background-color:#263238;
                      -fx-text-fill:white;">

            <font>
                <Font name="System Bold" size="22"/>
            </font>

        </Label>

        <VBox layoutX="30"
              layoutY="80"
              prefWidth="690"
              prefHeight="510"
              spacing="18"
              style="-fx-background-color:white;
                     -fx-background-radius:15;
                     -fx-border-radius:15;
                     -fx-border-color:#CFD8DC;">

            <padding>
                <Insets top="20"
                        right="20"
                        bottom="20"
                        left="20"/>
            </padding>

            <children>

                <GridPane hgap="15"
                          vgap="15">

                    <columnConstraints>
                        <ColumnConstraints prefWidth="170"/>
                        <ColumnConstraints prefWidth="240"/>
                        <ColumnConstraints prefWidth="180"/>
                    </columnConstraints>
                    <Label text="Member ID:"
                           GridPane.rowIndex="0"
                           GridPane.columnIndex="0"/>

                    <TextField fx:id="memberIdTF"
                               promptText="Enter Member ID"
                               GridPane.rowIndex="0"
                               GridPane.columnIndex="1"/>

                    <Button text="Load Guest"
                            onAction="#searchButtonOA"
                            prefWidth="140"
                            style="-fx-background-color:#1565C0;
               -fx-text-fill:white;
               -fx-background-radius:10;"
                            GridPane.rowIndex="0"
                            GridPane.columnIndex="2">

                        <font>
                            <Font name="System Bold" size="12"/>
                        </font>

                    </Button>

                    <Label text="Member Name:"
                           GridPane.rowIndex="1"
                           GridPane.columnIndex="0"/>

                    <TextField fx:id="memberNameTF"
                               editable="false"
                               GridPane.rowIndex="1"
                               GridPane.columnIndex="1"/>

                    <Label text="Equipment:"
                           GridPane.rowIndex="2"
                           GridPane.columnIndex="0"/>

                    <ComboBox fx:id="equipmentCB"
                              onAction="#showAvailability"
                              prefWidth="220"
                              GridPane.rowIndex="2"
                              GridPane.columnIndex="1"/>

                    <Label text="Available Quantity:"
                           GridPane.rowIndex="3"
                           GridPane.columnIndex="0"/>

                    <TextField fx:id="availableQtyTF"
                               editable="false"
                               GridPane.rowIndex="3"
                               GridPane.columnIndex="1"/>

                    <Label text="Equipment Status:"
                           GridPane.rowIndex="4"
                           GridPane.columnIndex="0"/>

                    <TextField fx:id="equipmentStatusTF"
                               editable="false"
                               GridPane.rowIndex="4"
                               GridPane.columnIndex="1"/>

                    <Label text="Usage Duration:"
                           GridPane.rowIndex="5"
                           GridPane.columnIndex="0"/>

                    <ComboBox fx:id="durationCB"
                              prefWidth="220"
                              GridPane.rowIndex="5"
                              GridPane.columnIndex="1"/>

                    <Label text="Start Time:"
                           GridPane.rowIndex="6"
                           GridPane.columnIndex="0"/>

                    <TextField fx:id="startTimeTF"
                               editable="false"
                               GridPane.rowIndex="6"
                               GridPane.columnIndex="1"/>

                    <Label text="End Time:"
                           GridPane.rowIndex="7"
                           GridPane.columnIndex="0"/>

                    <TextField fx:id="endTimeTF"
                               editable="false"
                               GridPane.rowIndex="7"
                               GridPane.columnIndex="1"/>

                    <rowConstraints>
                        <RowConstraints/>
                        <RowConstraints/>
                        <RowConstraints/>
                        <RowConstraints/>
                        <RowConstraints/>
                        <RowConstraints/>
                        <RowConstraints/>
                        <RowConstraints/>
                    </rowConstraints>

                </GridPane>

                <Separator/>
                <HBox alignment="CENTER"
                      spacing="20">

                    <Button text="Record Equipment Usage"
                            prefWidth="220"
                            prefHeight="45"
                            onAction="#assignEquipmentOA"
                            style="-fx-background-color:#2E7D32;
                   -fx-text-fill:white;
                   -fx-background-radius:10;">

                        <font>
                            <Font name="System Bold" size="13"/>
                        </font>

                    </Button>

                    <Button text="Back to Dashboard"
                            prefWidth="190"
                            prefHeight="45"
                            onAction="#backToDashboardOA"
                            style="-fx-background-color:#616161;
                   -fx-text-fill:white;
                   -fx-background-radius:10;">

                        <font>
                            <Font name="System Bold" size="13"/>
                        </font>

                    </Button>

                </HBox>

            </children>

        </VBox>

    </children>

</AnchorPane>