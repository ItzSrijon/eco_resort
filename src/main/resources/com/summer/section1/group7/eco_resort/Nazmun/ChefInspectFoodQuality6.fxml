<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="650.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer.section1.group7.eco_resort.Nazmun.Controller.ChefInspectFoodQualityController">

    <Label layoutX="270.0" layoutY="20.0" text="Food Quality Inspection">
        <font>
            <Font name="System Bold" size="20.0" />
        </font>
    </Label>

    <!-- Today's Dishes TableView (loaded from Daily Preparation) -->
    <TableView fx:id="dishTableView" layoutX="30.0" layoutY="60.0" prefHeight="200.0" prefWidth="840.0">
        <columns>
            <TableColumn fx:id="dishIdTC" prefWidth="90.0" text="Dish ID" />
            <TableColumn fx:id="dishNameTC" prefWidth="200.0" text="Dish Name" />
            <TableColumn fx:id="stationTC" prefWidth="180.0" text="Station" />
            <TableColumn fx:id="assignedStaffTC" prefWidth="180.0" text="Assigned Staff" />
        </columns>
    </TableView>

    <!-- Rating Section -->
    <Label layoutX="30.0" layoutY="280.0" text="Rate Selected Dish (1-5)">
        <font>
            <Font name="System Bold" size="14.0" />
        </font>
    </Label>

    <VBox layoutX="30.0" layoutY="310.0" prefWidth="840.0" spacing="12.0">
        <padding>
            <Insets bottom="10.0" left="0.0" right="0.0" top="0.0" />
        </padding>

        <HBox spacing="10.0">
            <Label prefWidth="120.0" text="Taste:" />
            <RadioButton fx:id="taste1RB" text="1" />
            <RadioButton fx:id="taste2RB" text="2" />
            <RadioButton fx:id="taste3RB" text="3" />
            <RadioButton fx:id="taste4RB" text="4" />
            <RadioButton fx:id="taste5RB" text="5" />
        </HBox>

        <HBox spacing="10.0">
            <Label prefWidth="120.0" text="Presentation:" />
            <RadioButton fx:id="presentation1RB" text="1" />
            <RadioButton fx:id="presentation2RB" text="2" />
            <RadioButton fx:id="presentation3RB" text="3" />
            <RadioButton fx:id="presentation4RB" text="4" />
            <RadioButton fx:id="presentation5RB" text="5" />
        </HBox>

        <HBox spacing="10.0">
            <Label prefWidth="120.0" text="Portion Size:" />
            <RadioButton fx:id="portion1RB" text="1" />
            <RadioButton fx:id="portion2RB" text="2" />
            <RadioButton fx:id="portion3RB" text="3" />
            <RadioButton fx:id="portion4RB" text="4" />
            <RadioButton fx:id="portion5RB" text="5" />
        </HBox>

        <HBox spacing="10.0">
            <Button fx:id="saveRatingButtonOA" onAction="#saveRatingButtonOA" text="Save Rating" />
            <Label fx:id="ratingMessageLabel" textFill="RED" />
        </HBox>
    </VBox>

    <!-- Inspection Log TableView -->
    <Label layoutX="30.0" layoutY="470.0" text="Inspection Log">
        <font>
            <Font name="System Bold" size="14.0" />
        </font>
    </Label>

    <TableView fx:id="logTableView" layoutX="30.0" layoutY="500.0" prefHeight="100.0" prefWidth="840.0">
        <columns>
            <TableColumn fx:id="logDishNameTC" prefWidth="200.0" text="Dish Name" />
            <TableColumn fx:id="logTasteTC" prefWidth="140.0" text="Taste" />
            <TableColumn fx:id="logPresentationTC" prefWidth="160.0" text="Presentation" />
            <TableColumn fx:id="logPortionTC" prefWidth="160.0" text="Portion Size" />
        </columns>
    </TableView>

    <Button fx:id="backButtonOA" layoutX="30.0" layoutY="610.0" onAction="#backButtonOA" text="Back to Dashboard" />

</AnchorPane>
