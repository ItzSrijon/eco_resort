<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer.section1.group7.eco_resort.Nazmun.Controller.ManageRoomRateController">

    <Label layoutX="320.0" layoutY="20.0" text="Room Management">
        <font>
            <Font name="System Bold" size="20.0" />
        </font>
    </Label>

    <TableView fx:id="roomTableView" layoutX="30.0" layoutY="60.0" prefHeight="220.0" prefWidth="840.0">
        <columns>
            <TableColumn fx:id="roomIdTC" prefWidth="100.0" text="Room ID" />
            <TableColumn fx:id="roomTypeTC" prefWidth="200.0" text="Room Type" />
            <TableColumn fx:id="rateTC" prefWidth="180.0" text="Rate" />
            <TableColumn fx:id="occupancyTC" prefWidth="180.0" text="Occupancy Status" />
        </columns>
    </TableView>

    <Label layoutX="30.0" layoutY="300.0" text="Add New Room">
        <font>
            <Font name="System Bold" size="14.0" />
        </font>
    </Label>

    <VBox layoutX="30.0" layoutY="330.0" prefWidth="840.0" spacing="10.0">
        <padding>
            <Insets bottom="10.0" left="0.0" right="0.0" top="0.0" />
        </padding>
        <HBox spacing="10.0">
            <ComboBox fx:id="newRoomTypeCB" prefWidth="180.0" promptText="Room Type" />
            <TextField fx:id="newRoomRateTF" prefWidth="150.0" promptText="Rate" />
            <Button fx:id="addRoomButtonOA" onAction="#addRoomButtonOA" text="Add Room" />
        </HBox>
    </VBox>

    <Label layoutX="30.0" layoutY="400.0" text="Update Selected Room">
        <font>
            <Font name="System Bold" size="14.0" />
        </font>
    </Label>

    <VBox layoutX="30.0" layoutY="430.0" prefWidth="840.0" spacing="10.0">
        <padding>
            <Insets bottom="10.0" left="0.0" right="0.0" top="0.0" />
        </padding>
        <HBox spacing="10.0">
            <TextField fx:id="newRateTF" prefWidth="150.0" promptText="New Rate" />
            <Button fx:id="saveRateButtonOA" onAction="#saveRateButtonOA" text="Save Rate" />
        </HBox>
        <HBox spacing="10.0">
            <ComboBox fx:id="occupancyCB" prefWidth="180.0" promptText="Occupancy Status" />
            <Button fx:id="saveStatusButtonOA" onAction="#saveStatusButtonOA" text="Save Status" />
        </HBox>
    </VBox>

    <Label fx:id="summaryLabel" layoutX="30.0" layoutY="560.0" text="Total: 0   Vacant: 0   Occupied: 0   Maintenance: 0">
        <font>
            <Font name="System Bold" size="13.0" />
        </font>
    </Label>

    <Button fx:id="backButtonOA" layoutX="30.0" layoutY="620.0" onAction="#backButtonOA" text="Back to Dashboard" />

</AnchorPane>